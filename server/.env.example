# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sound_check

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=30

# ─── Resend (Email OTP) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── ML / Models ──────────────────────────────────────────
MODELS_DIR=/path/to/model-weights

# ─── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_H=48
EXEMPT_EMAILS=placeholder1@example.com,placeholder2@example.com
